{
  // ---- поля з таблиці games ----
  "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",      // uuid, PRIMARY KEY
  "created_at": "2026-11-02T13:00:00+00:00",         // timestamptz, коли створили гру
  "host_id": "22222222-2222-2222-2222-222222222222", // uuid, посилається на profiles.id (організатор)

  "sport": "padel",                                  // text: 'padel' | 'tennis' | 'squash'
  "type": "game",                                    // text: 'game' | 'tournament' | 'qualification'

  "location": "Asturias Padel Center",               // text, назва клубу
  "location_url": "https://maps.app.goo.gl/...",     // text, може бути null
  "court": "1",                                      // text, може бути null

  "started_at": "2026-11-10T18:00:00+01:00",         // timestamptz, початок гри
  "duration_time": 60,                               // integer, хвилини
  "price": 18.00,                                    // numeric(8,2), ціна з гравця
  "currency": "€",                                   // text

  "max_players": 4,                                  // smallint
  "level_min": 1.5,                                  // numeric(3,1), може бути null
  "level_max": null,                                 // numeric(3,1), може бути null
  "strict_level": false,                             // boolean

  "score": ["6:3", "6:4"],                           // jsonb, масив рядків, за замовчуванням []
  "winning_team": "A",                               // text, може бути null: 'A' | 'B'

  // ---- додаткове поле, яке рахує сама view ----
  "players_count": 2                                 // integer, кількість рядків у game_players для цієї гри
}