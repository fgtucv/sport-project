{
  "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",   // uuid, PRIMARY KEY, автоматично
  "created_at": "2026-11-02T13:00:00+00:00",      // timestamptz, автоматично
  "host_id": "22222222-2222-2222-2222-222222222222", // uuid, обов'язкове, посилається на profiles.id (організатор)

  "sport": "padel",                               // text, обов'язкове: 'padel' | 'tennis' | 'squash'
  "type": "game",                                 // text, за замовчуванням 'game': 'game' | 'tournament' | 'qualification'

  "location": "Asturias Padel Center",            // text, обов'язкове, назва клубу
  "location_url": "https://maps.app.goo.gl/...",  // text, може бути null, посилання на карту
  "court": "1",                                   // text, може бути null, номер/назва корту

  "started_at": "2026-11-10T18:00:00+01:00",      // timestamptz, обов'язкове, дата і час початку
  "duration_time": 60,                            // integer, обов'язкове, хвилини, більше 0
  "price": 18.00,                                 // numeric(8,2), ціна з гравця, не менше 0
  "currency": "€",                                // text, за замовчуванням '€'

  "max_players": 4,                               // smallint, за замовчуванням 4
  "level_min": 1.5,                               // numeric(3,1), може бути null, мінімальний рівень
  "level_max": null,                              // numeric(3,1), може бути null, не менше level_min
  "strict_level": false,                          // boolean, true = гравці нижчого рівня не можуть приєднатись

  "score": ["6:3", "6:4"],                        // jsonb, масив рядків, за замовчуванням []
  "winning_team": "A"                             // text, може бути null: 'A' | 'B'
}